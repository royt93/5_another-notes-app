<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Vertical timeline line extending through this item -->
    <View
        android:id="@+id/timelineLineView"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:background="?colorPrimary"
        android:alpha="0.4" />

    <!-- Dot on the timeline line -->
    <View
        android:id="@+id/timelineDotView"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="21dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_timeline_dot"
        android:elevation="1dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="32dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/titleTxv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?textAppearanceBodyMedium"
                tools:text="Meeting notes for Q2 review" />

            <TextView
                android:id="@+id/contentTxv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?textAppearanceBodySmall"
                android:visibility="gone"
                tools:text="Remember to bring the Q2 figures..."
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/moodTxv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="😄"
            tools:visibility="visible" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
